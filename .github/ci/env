# Loaded into the python job's environment by the shared python.yml. Test-only values, never secrets.
# The Postgres service python.yml starts (postgres: "17" in ci.yml) is root/root on localhost:5432;
# .github/ci/setup.sh creates both databases. The suite derives one database per xdist worker
# from TEST_DATABASE_URL (tests/conftest.py).
DATABASE_URL=postgresql+asyncpg://root:root@localhost:5432/tvbf
TEST_DATABASE_URL=postgresql+asyncpg://root:root@localhost:5432/tvbf_test
ADMIN_TOKEN=test-admin-token
CORS_ALLOWED_ORIGINS=https://app.tvbf.localhost
